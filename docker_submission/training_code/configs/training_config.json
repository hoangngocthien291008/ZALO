{
  "base_model": "Qwen/Qwen2.5-Coder-14B-Instruct",
  "task": "DataMate Natural Language to Python Agent",
  "lora": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "bias": "none",
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "training": {
    "learning_rate": 0.0002,
    "batch_size": 2,
    "gradient_accumulation_steps": 8,
    "num_train_epochs": 3,
    "fp16": true,
    "optim": "paged_adamw_8bit",
    "logging_steps": 10,
    "seed": 42
  }
}
